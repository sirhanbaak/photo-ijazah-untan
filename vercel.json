{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/login", "destination": "/user/login.html", "permanent": false },
    { "source": "/login.html", "destination": "/user/login.html", "permanent": false },
    { "source": "/masuk", "destination": "/user/login.html", "permanent": false },
    { "source": "/mfa", "destination": "/user/mfa.html", "permanent": false },
    { "source": "/mfa.html", "destination": "/user/mfa.html", "permanent": false },
    { "source": "/dashboard", "destination": "/user", "permanent": false },
    { "source": "/akun", "destination": "/user", "permanent": false },
    { "source": "/forgot-password", "destination": "/user/forgot-password.html", "permanent": false },
    { "source": "/forgot-password.html", "destination": "/user/forgot-password.html", "permanent": false },
    { "source": "/lupa-password", "destination": "/user/forgot-password.html", "permanent": false },
    { "source": "/reset-password", "destination": "/user/reset-password.html", "permanent": false },
    { "source": "/reset-password.html", "destination": "/user/reset-password.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
